project = "proj-cloud"
region  = "us-east-1"
azs     = ["us-east-1a", "us-east-1b"]

# Public forks containing the application source
backend_repo       = "https://github.com/<you>/backend.git"
frontend_dist_repo = "https://github.com/<you>/client.git"

# Optional SSH access (leave key_name = "" to disable)
key_name = ""                    # e.g. "proj-key"
ssh_cidr = "203.0.113.4/32"      # https://checkip.amazonaws.com

# Database
db_name     = "appdb"
db_username = "appuser"
# db_password is provided via:   $env:TF_VAR_db_password = "..."
